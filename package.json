{
  "name": "energybubble",
  "version": "3.2.7",
  "description": "energybubble's website",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/tempertemper/energybubble.git"
  },
  "scripts": {
    "clear": "rm -rf dist",
    "sass": "sass --load-path=src/scss src/scss/style.scss dist/assets/css/style.css --style=compressed",
    "build:assets": "npm run sass",
    "build:eleventy": "npx @11ty/eleventy",
    "build": "npm run clear && npm run build:assets && npm run build:eleventy",
    "serve": "npx @11ty/eleventy --serve --quiet",
    "watch:css": "onchange 'src/scss' -- npm run sass",
    "watch:assets": "run-p watch:css",
    "start": "npm run clear && npm run build:assets && run-p serve watch:assets",
    "cms": "npx netlify-cms-proxy-server",
    "staging": "npm run build && echo 'User-agent: *\nDisallow: /' > dist/robots.txt",

    "version": "node scripts/sync-site-version.js",
    "_bump:commit": "git add package*.json src/site/_data/site.json && git commit -m \"Bumps version number to $npm_package_version\"",
    "bump:patch": "npm version patch --no-git-tag-version && npm run _bump:commit",
    "bump:minor": "npm version minor --no-git-tag-version && npm run _bump:commit",
    "bump:major": "npm version major --no-git-tag-version && npm run _bump:commit"
  },
  "author": "Beatriz Rodríguez Pérez",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/tempertemper/energybubble/issues"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0",
    "sass": "^1.90.0",
    "smartypants": "^0.2.2",
    "uslug": "^1.0.4"
  }
}
